# ============================================================================
# Blanc — backend. Variables de entorno.
#
# SOLO NOMBRES Y FORMATOS: ninguna credencial real vive en este archivo
# (principio 12.3 de `02-architecture-principles.md`). En producción viven en
# el gestor de variables de Railway.
#
# Las marcadas OBLIGATORIA impiden arrancar o funcionar si faltan. Las demás
# FALLAN CERRADO: el adaptador que las usa no envía nada en vez de enviar sin
# autenticar. Un despliegue incompleto no manda mensajes por accidente.
# ============================================================================

# ---------------------------------------------------------------------------
# Base de datos (OBLIGATORIA)
# ---------------------------------------------------------------------------
# Cadena de conexión de Supabase Postgres (`P1`). En Railway, usa la cadena del
# *connection pooler* de Supabase, no la directa.
DATABASE_URL=postgresql://postgres:password@localhost:5432/blanc

# ---------------------------------------------------------------------------
# Supabase Auth — verificación de JWT (OBLIGATORIAS)
# ---------------------------------------------------------------------------
# URL base del proyecto (Settings → API → Project URL). De aquí se derivan el
# `issuer` esperado Y el `jwks_uri` de la verificación ES256 (`DEC-021`/`DEC-026`):
# deliberadamente NO existe una variable separada para el JWKS.
SUPABASE_URL=

# Secreto de la rama HS256 legacy (`DEC-026`). Los proyectos nuevos de Supabase
# firman con ES256 y resuelven por JWKS; esta variable cubre los que aún usan
# HS256. Si el proyecto es ES256, basta `SUPABASE_URL`.
JWT_SECRET=

# Service Role Key, SOLO server-to-server contra la Admin API (`FL-SEG-06`,
# `DEC-023`/`DEC-028`). Es el secreto de mayor privilegio del proyecto:
# NUNCA debe exponerse al cliente, aparecer en logs ni versionarse.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# WhatsApp Cloud API de Meta (`DEC-043`, `ADR-008` Enmienda 1)
# ---------------------------------------------------------------------------
# App Secret, para verificar el HMAC de `X-Hub-Signature-256`.
# ⚠️ SI FALTA, EL WEBHOOK RECHAZA TODO. Es lo correcto: un webhook sin App
# Secret no puede distinguir a Meta de un tercero.
META_APP_SECRET=

# Token del reto `GET` de verificación del webhook. Lo eliges tú y lo pegas
# igual en el Meta Business Manager. Si falta, el reto se rechaza — aceptarlo
# vacío dejaría que un tercero registrara nuestra URL en su propia app.
META_VERIFY_TOKEN=

# Token de acceso permanente del System User con permiso sobre el WABA.
# ⚠️ SI FALTA, NO SE ENVÍA NINGÚN MENSAJE (adaptador de solo-log). Por defecto
# está vacío a propósito: el trámite con Meta es previo, y lo peligroso sería
# lo contrario — enviar mensajes reales desde un entorno de prueba.
WHATSAPP_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# OpenAI (`P1`: intérprete con salida estructurada, nunca decide reglas)
# ---------------------------------------------------------------------------
# ⚠️ SI FALTA, el bot usa el intérprete DETERMINISTA, que es un modo de
# operación válido: atiende saludos, precios y disponibilidad, y escala el
# resto. No es una degradación (`ADR-026`).
OPENAI_API_KEY=

# Modelo. Si se omite, `gpt-4o-mini`.
OPENAI_MODELO=

# CORTACIRCUITOS DE GASTO (`F-07`): tope de llamadas al modelo POR DÍA de pared
# de Querétaro. Si se omite, el tope por defecto es 500 — **finito a propósito**:
# uno ilimitado dejaría sin protección a quien no configure esto, que es quien
# más lo necesita. `0` apaga el modelo por completo.
#
# Al alcanzarlo, el bot NO deja de funcionar: usa el intérprete determinista, que
# no tiene coste por mensaje. Degrada la comprensión, no el servicio — escalar
# todo a humano agravaría `F-05` (escalada masiva que nadie puede absorber).
#
# La cuenta vive en PostgreSQL (`agente.consumo_de_ia`), así que SOBREVIVE A
# REINICIOS: un contador en memoria volvería a cero en cada reinicio y el tope no
# se alcanzaría nunca, justo en el escenario de bucle que esto previene.
OPENAI_MAX_LLAMADAS_DIA=500

# ---------------------------------------------------------------------------
# Interruptores de operación (los dos son el plan de rollback)
# ---------------------------------------------------------------------------
# `false` apaga los 4 barridos del planificador dejando los endpoints vivos
# (`ADR-025`). Cualquier otro valor los deja activos.
PLANIFICADOR_ACTIVO=true

# `false` deja el canal de WhatsApp atendido SOLO POR PERSONAS: el bot no
# responde a nadie (`ADR-026`). NO se apaga quitando el módulo — sin
# `AgenteModule` nadie provee el puerto y la aplicación no arranca.
BOT_ACTIVO=true

# RETENCIÓN DEL CONTENIDO CONVERSACIONAL (`ADR-029`). Días tras los que un
# mensaje se purga. VACÍO O `0` = NO SE PURGA NADA, y es el valor por defecto a
# propósito: `ADR-029` cerró la ESTRUCTURA de la retención pero NO el valor, que
# depende de la Pregunta Abierta #12 (marco legal de datos personales, sin
# confirmar). Inventar un número aquí parecería una decisión informada sobre
# obligaciones legales cuando sería una suposición — y un borrado es irreversible.
#
# Cuando se purga, borra filas de `conversaciones.mensajes` por lotes de 5.000 y
# NUNCA toca `auditoria`: los metadatos de las decisiones de IA viven en otra
# tabla y nunca contuvieron el texto (`RN-AUD-01`). Eso es lo que resolvió la
# contradicción entre `ADR-007` y `ADR-017`/`ADR-022`.
#
# Un valor no entero o negativo se trata como "no configurado": un typo no debe
# borrar con un umbral absurdo ni desactivar la purga creyéndola activa.
RETENCION_MENSAJES_DIAS=

# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------
PORT=3000

# Orígenes permitidos por CORS, separados por comas.
# Si se omite EN PRODUCCIÓN, CORS queda DESACTIVADO, asumiendo el frontend
# servido desde el mismo origen que la API (`ADR-027`) — que es el despliegue
# previsto. Nunca se responde `*`: la API se autentica con un JWT en cabecera,
# y un `*` permitiría a cualquier página usar el token de una Encargada.
CORS_ORIGIN=

# `production` endurece el comportamiento por defecto (ver CORS_ORIGIN).
NODE_ENV=development

# ---------------------------------------------------------------------------
# Bootstrap de producción — SOLO para `npm run db:seed`
# ---------------------------------------------------------------------------
# Usuario inicial. Sin él, la base queda sembrada y NADIE PUEDE ENTRAR: todos
# los endpoints de alta exigen SUPER_ADMIN o ADMINISTRADOR.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NOMBRE=

# El uuid del usuario en Supabase: Authentication → Users → columna "UID".
# NO es el correo. Si no es un uuid, el seed falla antes de escribir nada.
SUPER_ADMIN_SUPABASE_SUB=

# `phone_number_id` de cada sucursal (Meta → WhatsApp → API Setup).
# OPCIONALES: los tres números se migran en momentos distintos
# (`GO_LIVE_RUNBOOK.md`). Una sucursal sin número opera desde el mostrador;
# lo único que no puede es recibir WhatsApp. Volver a correr el seed después
# de migrar un número lo da de alta sin tocar lo demás.
PHONE_NUMBER_ID_ZIBATA=
PHONE_NUMBER_ID_LOMAS=
PHONE_NUMBER_ID_ALAMOS=
