# Blanc backend — variables de entorno
# Ninguna credencial real vive en este archivo (principio 12.3, 02-architecture-principles.md).

# Cadena de conexión de Supabase Postgres (P1, ARCHITECTURE_CLOSURE_PLAN.md).
DATABASE_URL=postgresql://postgres:password@localhost:5432/blanc

# Secreto de verificación de JWT de Supabase Auth para la rama HS256 legacy (DEC-026). En
# producción vive en el gestor de secretos de Supabase/Railway, nunca en este archivo (principio 12.3).
JWT_SECRET=replace-with-supabase-jwt-secret

# URL base del proyecto Supabase de Blanc (Project URL, Settings → API). De aquí se derivan tanto
# el `issuer` esperado como el `jwks_uri` de la verificación ES256/JWKS (DEC-021/DEC-026) —
# deliberadamente no existe una variable independiente para la URL del JWKS.
SUPABASE_URL=

# Service Role Key del proyecto Supabase, usada SOLO server-to-server contra la Admin API
# (FL-SEG-06, provisionamiento de identidades — DEC-023/DEC-028). Es el secreto de mayor
# privilegio del proyecto: nunca debe exponerse al cliente, aparecer en logs ni versionarse.
SUPABASE_SERVICE_ROLE_KEY=

PORT=3000
