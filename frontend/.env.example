# ============================================================================
# Blanc — frontend. Variables de entorno.
#
# SOLO NOMBRES: ningún valor real se escribe en el repositorio (`ADR-027`).
#
# Las dos de Supabase son PÚBLICAS POR DISEÑO: viajan en el bundle,
# inevitablemente. Lo que protege los datos es RLS y el `AuthorizationGuard`
# del backend, no el secreto de la `anon key`.
#
# ⚠️ La `service_role key` NO APARECE NUNCA en el frontend. Si alguna vez se
# añade aquí, queda publicada en el JavaScript que descarga cualquiera.
# ============================================================================

# URL del proyecto Supabase (Settings → API → Project URL). El login va contra
# Supabase Auth directo: Blanc NO emite tokens (`ADR-024` rechazó esa opción).
VITE_SUPABASE_URL=

# `anon` / `publishable` key del proyecto (Settings → API).
VITE_SUPABASE_ANON_KEY=

# Base de la API de Blanc. VACÍO = mismo origen, que es el despliegue previsto
# (estáticos servidos junto a la API). En desarrollo también se deja vacío: el
# proxy de Vite manda `/v1` a `localhost:3000`.
# Solo se rellena si el frontend se sirve en otro dominio — y entonces hay que
# añadir ese dominio a `CORS_ORIGIN` en el backend.
VITE_API_BASE=
